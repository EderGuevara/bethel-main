{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "forms/*.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/sw.js", "dest": "/sw.js", "headers": { "Cache-Control": "no-cache, must-revalidate" } },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/forms/(.*)", "dest": "/forms/$1", "headers": { "Cache-Control": "no-cache, must-revalidate" } },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/gastos", "dest": "/forms/control-de-gastos.html", "headers": { "Cache-Control": "no-cache, must-revalidate" } },
    { "src": "/interes-compuesto", "dest": "/interes-compuesto.html", "headers": { "Cache-Control": "no-cache, must-revalidate" } },
    { "src": "/admin", "dest": "/admin.html", "headers": { "Cache-Control": "no-cache, must-revalidate" } },
    { "src": "/portal", "dest": "/portal.html", "headers": { "Cache-Control": "no-cache, must-revalidate" } },
    { "src": "/(.+\\.(?:jpg|jpeg|png|gif|svg|ico|webp|css|js|woff|woff2|ttf))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
